# AIrena2.0 Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Key for GPT-4 access
OPENAI_API_KEY=your-openai-api-key-here

# Custom API base URL for your deployment endpoint:
# Example: https://aicafe.hcl.com/AICafeService/api/v1/subscription/openai/deployments/gpt-4.1
OPENAI_API_BASE=https://your-endpoint-here

# Optional: API version for the endpoint (default is the documented one)
OPENAI_API_VERSION=2024-12-01-preview

# Optional: Specify which OpenAI model to use (default: gpt-4.1)
# OPENAI_MODEL=gpt-4.1